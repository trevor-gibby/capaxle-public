{
  "name": "capaxle-workspace",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.15.0 || ^24.0.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "clean": "tsc --build --clean",
    "check:public": "npm run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "ajv": "8.20.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "@modelcontextprotocol/client": "2.2.0"
  }
}
