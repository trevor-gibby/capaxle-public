    "@capaxle/schema-zod": "0.1.0-alpha.3",
    "@capaxle/compiler": "0.1.0-alpha.3",
    "@capaxle/runtime": "0.1.0-alpha.3",
    "@capaxle/adapter-http": "0.1.0-alpha.3",
    "@capaxle/adapter-mcp": "0.1.0-alpha.3",
    "@capaxle/adapter-cli": "0.1.0-alpha.3",
    "@capaxle/generator-docs": "0.1.0-alpha.3",
    "@capaxle/docs-styles": "0.1.0-alpha.3",
    "typescript": "6.0.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
