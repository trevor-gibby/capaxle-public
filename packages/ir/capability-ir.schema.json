{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capaxle Capability IR 0.1",
  "description": "Structural schema for the normalized, portable Capability IR 0.1 document. Relational rules are enforced by the ordered semantic validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["irVersion", "service", "schemas", "capabilities"],
  "properties": {
    "irVersion": { "const": "0.1" },
    "service": { "$ref": "#/$defs/ServiceDescriptor" },
    "schemas": { "$ref": "#/$defs/SchemaRegistry" },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/CapabilityDefinition" }
    },
    "metadata": { "$ref": "#/$defs/BuildMetadata" }
  },
  "$defs": {
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "ServiceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "tags"],
      "properties": {
        "name": { "$ref": "#/$defs/NonEmptyString" },
        "version": { "$ref": "#/$defs/SemVer" },
        "title": { "$ref": "#/$defs/NonEmptyString" },
        "description": { "type": "string" },
        "homepage": { "$ref": "#/$defs/NonEmptyString" },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "$ref": "#/$defs/NonEmptyString" },
            "url": { "$ref": "#/$defs/NonEmptyString" },
            "email": { "$ref": "#/$defs/NonEmptyString" }
          }
        },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/NonEmptyString" },
          "uniqueItems": true
        }
      }
    },
    "BuildMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "$ref": "#/$defs/NonEmptyString" },
            "version": { "$ref": "#/$defs/SemVer" }
          }
        },
        "sourceHash": { "$ref": "#/$defs/NonEmptyString" },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceRepository": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "SchemaRegistry": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/CapabilityJsonSchema" }
    },
    "CapabilityJsonSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "$ref": {
          "type": "string",
          "pattern": "^#/(?:schemas|\\$defs)/(?:[^~/]|~0|~1)+$"
        },
        "$defs": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/CapabilityJsonSchema" }
        },
        "type": {
          "oneOf": [
            { "$ref": "#/$defs/JsonTypeName" },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/JsonTypeName" }
            }
          ]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {}
        },
        "const": {},
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/CapabilityJsonSchema" }
        },
        "required": {
          "type": "array",
          "items": { "$ref": "#/$defs/NonEmptyString" },
          "uniqueItems": true
        },
        "additionalProperties": { "type": "boolean" },
        "items": { "$ref": "#/$defs/CapabilityJsonSchema" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "exclusiveMinimum": { "type": "number" },
        "exclusiveMaximum": { "type": "number" },
        "multipleOf": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": { "type": "string" },
        "format": {
          "enum": [
            "date-time",
            "date",
            "time",
            "duration",
            "email",
            "hostname",
            "ipv4",
            "ipv6",
            "uri",
            "uuid"
          ]
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "uniqueItems": { "type": "boolean" },
        "description": { "type": "string" },
        "default": {},
        "examples": {
          "type": "array",
          "items": {}
        },
        "oneOf": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/CapabilityJsonSchema" }
        }
      }
    },
    "JsonTypeName": {
      "enum": [
        "null",
        "boolean",
        "object",
        "array",
        "number",
        "string",
        "integer"
      ]
    },
    "SchemaRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema"],
          "properties": {
            "schema": { "$ref": "#/$defs/CapabilityJsonSchema" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$ref"],
          "properties": {
            "$ref": {
              "type": "string",
              "pattern": "^#/schemas/(?:[^~/]|~0|~1)+$"
            }
          }
        }
      ]
    },
    "CapabilityDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "summary",
        "tags",
        "input",
        "output",
        "errors",
        "access",
        "effects",
        "execution",
        "requirements",
        "limits",
        "lifecycle",
        "interfaces",
        "examples"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
        },
        "version": { "$ref": "#/$defs/SemVer" },
        "summary": { "$ref": "#/$defs/NonEmptyString" },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/NonEmptyString" },
          "uniqueItems": true
        },
        "input": { "$ref": "#/$defs/SchemaRef" },
        "output": { "$ref": "#/$defs/SchemaRef" },
        "errors": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?!CAP_)[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": { "$ref": "#/$defs/ErrorDefinition" }
        },
        "access": { "$ref": "#/$defs/AccessPolicy" },
        "effects": { "$ref": "#/$defs/EffectPolicy" },
        "execution": { "$ref": "#/$defs/ExecutionPolicy" },
        "requirements": { "$ref": "#/$defs/RequirementPolicy" },
        "limits": { "$ref": "#/$defs/LimitPolicy" },
        "lifecycle": { "$ref": "#/$defs/LifecyclePolicy" },
        "interfaces": { "$ref": "#/$defs/InterfaceProjections" },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/CapabilityExample" }
        }
      }
    },
    "ErrorDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "message", "retryable"],
      "properties": {
        "status": {
          "enum": [
            "invalid_argument",
            "unauthenticated",
            "permission_denied",
            "not_found",
            "already_exists",
            "failed_precondition",
            "conflict",
            "resource_exhausted",
            "cancelled",
            "deadline_exceeded",
            "unavailable",
            "internal"
          ]
        },
        "message": { "$ref": "#/$defs/NonEmptyString" },
        "details": { "$ref": "#/$defs/SchemaRef" },
        "retryable": { "type": "boolean" },
        "docs": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "AccessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authentication", "permissions", "exposure"],
      "properties": {
        "authentication": { "enum": ["public", "optional", "required"] },
        "permissions": { "$ref": "#/$defs/Permissions" },
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["http", "cli", "mcp", "internal"],
          "properties": {
            "http": { "$ref": "#/$defs/ExposureLevel" },
            "cli": { "$ref": "#/$defs/ExposureLevel" },
            "mcp": { "$ref": "#/$defs/ExposureLevel" },
            "internal": { "$ref": "#/$defs/ExposureLevel" }
          }
        }
      }
    },
    "Permissions": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["public"],
          "properties": {
            "public": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allOf": {
              "type": "array",
              "items": { "$ref": "#/$defs/NonEmptyString" }
            },
            "anyOf": {
              "type": "array",
              "items": { "$ref": "#/$defs/NonEmptyString" }
            }
          }
        }
      ]
    },
    "ExposureLevel": {
      "enum": ["disabled", "private", "authenticated", "public"]
    },
    "EffectPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact", "idempotency", "confirmation", "retry"],
      "properties": {
        "impact": { "enum": ["read", "write", "destructive"] },
        "idempotency": { "enum": ["none", "intrinsic", "key"] },
        "confirmation": { "enum": ["none", "required"] },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["never", "safe"] }
          }
        }
      }
    },
    "ExecutionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "result", "cancellable"],
      "properties": {
        "mode": { "const": "inline" },
        "result": { "const": "unary" },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "cancellable": { "type": "boolean" }
      }
    },
    "RequirementPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secrets", "resources", "environment"],
      "properties": {
        "secrets": {
          "type": "array",
          "items": { "$ref": "#/$defs/SecretRequirement" }
        },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/ResourceRequirement" }
        },
        "environment": {
          "type": "array",
          "items": { "$ref": "#/$defs/EnvironmentRequirement" }
        }
      }
    },
    "SecretRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "optional"],
      "properties": {
        "name": { "$ref": "#/$defs/NonEmptyString" },
        "optional": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "ResourceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "optional"],
      "properties": {
        "name": { "$ref": "#/$defs/NonEmptyString" },
        "kind": { "$ref": "#/$defs/NonEmptyString" },
        "optional": { "type": "boolean" }
      }
    },
    "EnvironmentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "presence", "sensitive"],
      "properties": {
        "name": { "$ref": "#/$defs/NonEmptyString" },
        "presence": { "enum": ["required", "optional"] },
        "sensitive": { "type": "boolean" }
      }
    },
    "LimitPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": {
            "policy": { "$ref": "#/$defs/NonEmptyString" },
            "cost": {
              "type": "integer",
              "minimum": 1
            },
            "description": { "type": "string" }
          }
        }
      }
    },
    "LifecyclePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["experimental", "stable", "deprecated"] },
        "since": { "$ref": "#/$defs/SemVer" },
        "deprecatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sunsetAt": {
          "type": "string",
          "format": "date-time"
        },
        "replacement": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
        }
      }
    },
    "InterfaceProjections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http", "cli", "mcp", "docs", "sdk"],
      "properties": {
        "http": { "$ref": "#/$defs/HttpProjection" },
        "cli": { "$ref": "#/$defs/CliProjection" },
        "mcp": { "$ref": "#/$defs/McpProjection" },
        "docs": { "$ref": "#/$defs/DocsProjection" },
        "sdk": { "$ref": "#/$defs/SdkProjection" }
      }
    },
    "DisabledProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "const": false }
      }
    },
    "HttpProjection": {
      "oneOf": [
        { "$ref": "#/$defs/DisabledProjection" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "method", "path", "bindings"],
          "properties": {
            "enabled": { "const": true },
            "method": {
              "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"]
            },
            "path": { "$ref": "#/$defs/NonEmptyString" },
            "bindings": {
              "type": "object",
              "additionalProperties": {
                "enum": ["path", "query", "header", "body"]
              }
            }
          }
        }
      ]
    },
    "CliProjection": {
      "oneOf": [
        { "$ref": "#/$defs/DisabledProjection" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "command", "bindings"],
          "properties": {
            "enabled": { "const": true },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/NonEmptyString" }
            },
            "bindings": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/CliBinding" }
            }
          }
        }
      ]
    },
    "CliBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "option" },
            "name": {
              "type": "string",
              "pattern": "^--[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "index"],
          "properties": {
            "kind": { "const": "positional" },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "McpProjection": {
      "oneOf": [
        { "$ref": "#/$defs/DisabledProjection" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "toolName"],
          "properties": {
            "enabled": { "const": true },
            "toolName": { "$ref": "#/$defs/NonEmptyString" }
          }
        }
      ]
    },
    "DocsProjection": {
      "oneOf": [
        { "$ref": "#/$defs/DisabledProjection" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "const": true },
            "group": { "$ref": "#/$defs/NonEmptyString" }
          }
        }
      ]
    },
    "SdkProjection": {
      "oneOf": [
        { "$ref": "#/$defs/DisabledProjection" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "path"],
          "properties": {
            "enabled": { "const": true },
            "path": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/NonEmptyString" }
            }
          }
        }
      ]
    },
    "CapabilityExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input"],
      "properties": {
        "name": { "$ref": "#/$defs/NonEmptyString" },
        "description": { "type": "string" },
        "input": {},
        "output": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": { "$ref": "#/$defs/NonEmptyString" },
            "details": {}
          }
        }
      }
    }
  }
}
